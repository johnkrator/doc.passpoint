# API Base URL
# Leave empty to auto-detect environment:
#   - Development (localhost): http://localhost:3000
#   - Production: https://main-passpoint-documentation-api.vercel.app
# Or set explicitly to override:
VITE_API_URL=

# Examples:
# For local development with local backend:
# VITE_API_URL=http://localhost:3000

# For local development with production backend:
# VITE_API_URL=https://main-passpoint-documentation-api.vercel.app

# Site base URL — used for the Ask AI feature to construct the current page URL.
# Leave empty in dev (falls back to window.location.origin automatically).
# Set to the production URL in your deployment environment (Vercel, etc.)
VITE_SITE_URL=
# Production: VITE_SITE_URL=https://docs.mypasspoint.com
